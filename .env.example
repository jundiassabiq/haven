# Copy to .env, then run: php bin/keygen.php
APP_NAME=Haven
APP_ENV=local
# true shows exception details on the 500 page. Keep false for demos.
APP_DEBUG=false
# true shows the demo-account box on the sign-in page.
APP_DEMO=true
# AES-256-GCM key for report content. Generated by bin/keygen.php. Changing it makes existing reports unreadable.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haven_v2
DB_USER=root
DB_PASS=

SESSION_IDLE_MINUTES=30
